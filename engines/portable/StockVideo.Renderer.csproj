<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);SKIA</DefineConstants>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <Compile Include="../cinematic_renderer.cs" Link="Cinema.cs" />
    <Compile Include="../cover_renderer.cs" Link="Covers.cs" />
    <Compile Include="../classic_renderer.cs" Link="Classic.cs" />
  </ItemGroup>
</Project>
